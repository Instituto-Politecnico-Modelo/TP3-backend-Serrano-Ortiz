# ============================================================
# Variables de entorno — Sistema de Decanato IPM
# Copiar este archivo a .env y completar los valores reales.
# NUNCA commitear el archivo .env con credenciales reales.
# ============================================================

# ── Base de datos MySQL ──────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/Decanato-Ortiz-Serrano?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=CAMBIAR_EN_PRODUCCION

# ── JWT (feature 002) ────────────────────────────────────────
# Generar con: openssl rand -hex 64
JWT_SECRET=CAMBIAR_EN_PRODUCCION_USAR_OPENSSL_RAND_HEX_64

# Access token TTL en ms (default 1h = 3600000)
JWT_EXPIRATION_MS=3600000

# Refresh token TTL en ms (default 7 días = 604800000)
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Redis (feature 002 — blocklist de tokens revocados) ──────
REDIS_HOST=localhost
REDIS_PORT=6379
# Dejar vacío si Redis local no requiere contraseña
REDIS_PASSWORD=

# ── Bloqueo de cuenta (feature 002 — US3) ───────────────────
# Intentos fallidos antes de bloquear la cuenta
AUTH_MAX_INTENTOS=5
# Duración del bloqueo en minutos
AUTH_BLOQUEO_MINUTOS=15

# ── Aplicación ───────────────────────────────────────────────
APP_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Email (opcional — envío de notificaciones) ───────────────
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=noreply@decanato.edu.ar
# SPRING_MAIL_PASSWORD=APP_PASSWORD_AQUI
